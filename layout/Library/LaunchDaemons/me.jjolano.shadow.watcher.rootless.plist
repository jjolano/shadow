<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>me.jjolano.shadow.watcher</string>
	<key>ProgramArguments</key>
	<array>
		<string>/var/jb/usr/local/bin/shdw</string>
		<string>-d</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>StandardOutPath</key>
	<string>/var/jb/var/log/shadow-watcher.log</string>
	<key>StandardErrorPath</key>
	<string>/var/jb/var/log/shadow-watcher.log</string>
</dict>
</plist>
