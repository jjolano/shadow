#!/usr/bin/env bash

if [[ $DPKG_MAINTSCRIPT_ARCH == "iphoneos-arm64" ]]
then
    DPKG_ROOT="/var/jb"
fi

# SIGTERM the daemon and wait for a verified exit so it can unhide every
# VISSHADOW-flagged vnode first (leaked hidden vnodes panic the kernel at
# shutdown). Polls up to 10s at 0.5s intervals; returns 0 if the process is
# gone, 1 if it is still alive.
# Never SIGKILL: a force-kill drops the process with its flags still set —
# exactly the restart hazard this architecture exists to avoid (launchd
# respawns a half-cleaned daemon, or the vnodes stay hidden until reboot).
shadowd_stop() {
    # Send SIGTERM via launchd when the service exists; fall back to a raw
    # kill for the rare already-booted-out orphan.
    launchctl kill SIGTERM system/me.jjolano.shadow 2> /dev/null \
        || kill -TERM "$(pgrep -x shadowd)" 2> /dev/null || true
    for _ in $(seq 1 20); do
        pgrep -x shadowd > /dev/null 2>&1 || return 0
        sleep 0.5
    done
    return 1
}

case "$1" in
    configure)
        # Prefs plist: root-owned 0644 so apps (running as mobile) cannot write
        # their own hiding config; cfprefsd (root) still writes via the Settings
        # UI. Same path on rootful and rootless (/var/mobile exists on both).
        mkdir -p /var/mobile/Library/Preferences
        touch /var/mobile/Library/Preferences/me.jjolano.shadow.plist
        chown root:wheel /var/mobile/Library/Preferences/me.jjolano.shadow.plist
        chmod 0644 /var/mobile/Library/Preferences/me.jjolano.shadow.plist

        # Ruleset tree: root-owned, dirs 0755 / files 0644 (X grants execute
        # on directories only). World-writable mobile-owned rulesets let any
        # protected app tamper with its own hiding rules.
        chown -R root:wheel "$DPKG_ROOT/Library/Shadow"
        chmod -R u=rwX,go=rX "$DPKG_ROOT/Library/Shadow"

        # shdw runs as root from postinst/triggers, so it can still write.
        "$DPKG_ROOT/usr/local/bin/shdw" -g > /dev/null || true

        # Fat package (armv7/armv7s + arm64/arm64e in one deb): shadowd is
        # arm64-only and the rooted dep slices (libsandy/HookKit/AltList)
        # floor at iOS 12.0.
        #  - 32-bit devices: drop the daemon + plist so launchd never tries
        #    to exec an arm64-only binary (exec-fail respawn loop).
        #  - 64-bit on iOS < 12: the injected dylib chain can't load (deps
        #    are minos 12.0) — dyld would abort every app launch; drop the
        #    daemon and the injection files, leaving an inert install.
        DAEMON_ARCH_OK=1
        case "$(uname -m)" in
            armv7|armv7s)
                DAEMON_ARCH_OK=0
                rm -f "$DPKG_ROOT/usr/libexec/shadowd" \
                      "$DPKG_ROOT/Library/LaunchDaemons/me.jjolano.shadow.plist" \
                      "$DPKG_ROOT/Library/LaunchDaemons/me.jjolano.shadow.watcher.plist" 2>/dev/null
                ;;
            arm64|arm64e)
                OS_MAJOR=$(sw_vers -productVersion | cut -d. -f1)
                if [ "${OS_MAJOR:-0}" -lt 12 ]; then
                    DAEMON_ARCH_OK=0
                    rm -f "$DPKG_ROOT/Library/MobileSubstrate/DynamicLibraries/Shadow.dylib" \
                          "$DPKG_ROOT/Library/MobileSubstrate/DynamicLibraries/Shadow.plist" \
                          "$DPKG_ROOT/Library/MobileSubstrate/DynamicLibraries/ShadowCore.dylib" \
                          "$DPKG_ROOT/Library/MobileSubstrate/DynamicLibraries/ShadowCore.plist" \
                          "$DPKG_ROOT/Library/Frameworks/Shadow.framework" \
                          "$DPKG_ROOT/usr/libexec/shadowd" \
                          "$DPKG_ROOT/Library/LaunchDaemons/me.jjolano.shadow.plist" \
                          "$DPKG_ROOT/Library/LaunchDaemons/me.jjolano.shadow.watcher.plist" 2>/dev/null
                    rm -rf "$DPKG_ROOT/Library/Frameworks/Shadow.framework"
                fi
                ;;
        esac

        # LaunchDaemon: rootful ships /Library/LaunchDaemons, rootless ships
        # /var/jb/Library/LaunchDaemons (theos install-prefix); the fat
        # package ships it but the arch guards above strip it where shadowd
        # can't run.
        if [ "$DAEMON_ARCH_OK" = "1" ] && [ -f "$DPKG_ROOT/Library/LaunchDaemons/me.jjolano.shadow.plist" ]; then
            chown root:wheel "$DPKG_ROOT/Library/LaunchDaemons/me.jjolano.shadow.plist"
            chmod 644 "$DPKG_ROOT/Library/LaunchDaemons/me.jjolano.shadow.plist"
            chown root:wheel "$DPKG_ROOT/usr/libexec/shadowd"
            chmod 755 "$DPKG_ROOT/usr/libexec/shadowd"
            mkdir -p "$DPKG_ROOT/var/log"

            # On upgrade, prerm asked the old daemon to exit; a copy that
            # survived that gets one more graceful stop here. Never SIGKILL
            # (kickstart -k): killing mid-hide leaves VISSHADOW flags set.
            if pgrep -x shadowd > /dev/null 2>&1; then
                if ! shadowd_stop; then
                    # Still alive: do not replace it while it holds flagged
                    # vnodes. Abort the configure — dpkg leaves the package
                    # unpacked and the old daemon keeps running.
                    echo "shadowd: old daemon did not exit; ABORTING upgrade. REBOOT REQUIRED to fully restore hidden state." >&2
                    exit 1
                fi
            fi

            # Modern launchctl API; older iOS falls back to legacy load -w.
            # (On upgrades bootstrap/load fail with "already loaded" when the
            # old service is still registered — harmless, the service is kept.)
            launchctl bootstrap system "$DPKG_ROOT/Library/LaunchDaemons/me.jjolano.shadow.plist" 2> /dev/null \
                || launchctl load -w "$DPKG_ROOT/Library/LaunchDaemons/me.jjolano.shadow.plist" 2> /dev/null || true

            # Ruleset watcher: shdw -d regenerates the installed-apps ruleset
            # on app install/uninstall (stateless, no shutdown dance needed —
            # unlike shadowd it holds no kernel state).
            chown root:wheel "$DPKG_ROOT/Library/LaunchDaemons/me.jjolano.shadow.watcher.plist"
            chmod 644 "$DPKG_ROOT/Library/LaunchDaemons/me.jjolano.shadow.watcher.plist"
            chown root:wheel "$DPKG_ROOT/usr/local/bin/shdw"
            chmod 755 "$DPKG_ROOT/usr/local/bin/shdw"
            launchctl bootstrap system "$DPKG_ROOT/Library/LaunchDaemons/me.jjolano.shadow.watcher.plist" 2> /dev/null \
                || launchctl load -w "$DPKG_ROOT/Library/LaunchDaemons/me.jjolano.shadow.watcher.plist" 2> /dev/null || true
        fi
    ;;

    triggered)
        "$DPKG_ROOT/usr/local/bin/shdw" -g > /dev/null || true
    ;;
esac

exit 0
