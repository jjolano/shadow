#!/usr/bin/env bash

if [[ $DPKG_MAINTSCRIPT_ARCH == "iphoneos-arm64" ]]
then
    DPKG_ROOT="/var/jb"
fi

# SIGTERM the daemon and wait for a verified exit so it can unhide every
# VISSHADOW-flagged vnode first (leaked hidden vnodes panic the kernel at
# shutdown). Polls up to 10s at 0.5s intervals; returns 0 if the process is
# gone, 1 if it is still alive.
# Never SIGKILL: a force-kill drops the process with its flags still set —
# exactly the restart hazard this architecture exists to avoid (launchd
# respawns a half-cleaned daemon, or the vnodes stay hidden until reboot).
shadowd_stop() {
    # Send SIGTERM via launchd when the service exists; fall back to a raw
    # kill for the rare already-booted-out orphan.
    launchctl kill SIGTERM system/me.jjolano.shadow 2> /dev/null \
        || kill -TERM "$(pgrep -x shadowd)" 2> /dev/null || true
    for _ in $(seq 1 20); do
        pgrep -x shadowd > /dev/null 2>&1 || return 0
        sleep 0.5
    done
    return 1
}

case "$1" in
    remove|upgrade)
        if ! shadowd_stop; then
            # Still alive after 10s of SIGTERM. Do NOT escalate to SIGKILL
            # and do NOT bootout: terminating a daemon that still holds
            # VISSHADOW-flagged vnodes leaves them hidden until reboot.
            # Abort the removal — dpkg keeps the package installed and the
            # daemon running (non-zero prerm aborts remove/upgrade).
            echo "shadowd: did not exit after SIGTERM; ABORTING removal. REBOOT REQUIRED to fully restore hidden state." >&2
            exit 1
        fi
        launchctl bootout system/me.jjolano.shadow 2> /dev/null \
            || launchctl unload "$DPKG_ROOT/Library/LaunchDaemons/me.jjolano.shadow.plist" 2> /dev/null || true

        # The ruleset watcher is stateless (no kernel flags to clear) — plain
        # bootout; failure to stop it must not abort the removal.
        launchctl bootout system/me.jjolano.shadow.watcher 2> /dev/null \
            || launchctl unload "$DPKG_ROOT/Library/LaunchDaemons/me.jjolano.shadow.watcher.plist" 2> /dev/null || true
    ;;
esac

exit 0
