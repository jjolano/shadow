    "dyldprobe": { "outcome": "clean", "notChecked": [] },
    "freerasp": { "outcome": "clean", "notChecked": ["freerasp.debug"] },
    "iossecuritysuite": {
      "outcome": "clean",
      "notChecked": [
        "iossecuritysuite.dylibs",
        "iossecuritysuite.integrity.bundle",
        "iossecuritysuite.jailbreak",
        "iossecuritysuite.runtime_hook"
      ]
    },
    "isjailbroken": { "outcome": "clean", "notChecked": [] },
    "jailbreakdetector": { "outcome": "clean", "notChecked": [] },
    "jailmonkey": { "outcome": "clean", "notChecked": ["jailmonkey.dylibs"] },
    "roothider": { "outcome": "clean", "notChecked": [] },
    "safetynet": {
      "outcome": "clean",
      "notChecked": [
        "safetynet.antidebug",
        "safetynet.breakpoint",
        "safetynet.mshook"
      ]
    },
    "securitytoolkit": { "outcome": "clean", "notChecked": [] },
