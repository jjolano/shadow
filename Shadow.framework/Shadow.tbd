---
archs:                 [ armv7, armv7s, arm64, arm64e ]
platform:              ios
install-name:          '@rpath/Shadow.framework/Shadow'
current-version:       0
compatibility-version: 0
exports:
  - archs:                [ armv7, armv7s, arm64, arm64e ]
    objc-classes:         [ _Shadow,
                            _ShadowSettings,
                            _SystemRulesGenerator ]
    symbols:              [ _SHDWHookPlan, _SHDWInstallUnits,
                            _SHDWDefaultHookSettings, _SHDWPresetStandard,
                            _SHDWPresetMaximum, _SHDWHookGroupCapabilityKind,
                            _shdw_ruleset_generation,
                            _shdwInternalBusy,
                            _JBPath, _JBIsRootless,
                            _shdw_is_restricted_root, _shdw_is_restricted_root_c, _shdw_path_contains_restricted_root_c, _shdw_is_path_in_restricted_root, _shdw_jbroot_prefix ]
...
