.theos
packages/
build/
.DS_Store
.vscode
.slim/deepwork/
tests/harness
tests/harness.d
tests/*.gcno
tests/*.gcda
tests/*.gcov
artifacts/
# Built framework staged by build.sh stage_deps(); theos links against it
# via _THEOS_INTERNAL_SEARCHPATHS. Never a source checkout.
vendor/HookKit.framework/
.detector-deps/
tests/[private-harness]/concurrency/
core
core.*
# Stray Swift module blobs a mis-cwd'd build can drop at the repo root.
/Swift-*.swiftmodule
# Theos mirrors a subproject's cross-tree _FILES (e.g. ../../[private-runner] in
# dyldprobe, ../../[private-harness] in the DeviceSecurityKit runner) as an empty
# stamp dir named after the escaped path segment; it is build output.
tests/tools/dyldprobe/[private-runner]/
tests/[private-runner]/*/[private-harness]/
__pycache__/
*.py[cod]
# Maintainer-local notes. Never committed; never force-add.
private/
