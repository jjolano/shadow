<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Single source of truth for jailbreak-app identifier lists that have no
  restriction-ruleset home. scripts/gen-jb-identifiers.py renders these into a
  generated C header of `static const char* const` arrays; the arrays are baked
  into ShadowCore at compile time exactly as the previous inline literals were,
  so runtime lookup behaviour is unchanged (see AppEnvironment.x
  shdw_nsuserdefaults_suite_restricted).

  Categories have distinct match semantics:
    * NSUserDefaultsSuites: exact full suite name.
    * JBPreferenceDomainIDs: exact last path component.

  Order is preserved as-authored. Add identifiers here, not in source.
-->
<plist version="1.0">
<dict>
	<key>NSUserDefaultsSuites</key>
	<array>
		<string>com.saurik.Cydia</string>
		<string>com.saurik.Cydia.Startup</string>
