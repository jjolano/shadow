"DNGR_HOOKS" = "⚠︎ 危险Hook";
"DNGR_HOOKS_DESC" = "底层屏蔽方法。可能导致应用崩溃或系统功能异常。仅在推荐的Hook无法生效时启用。";
"HOOK_SANDBOX" = "增强应用沙盒";
"HOOK_SANDBOX_DESC" = "让特权操作和仅越狱环境存在的服务像在普通应用沙盒中一样失败。\n\n这些底层 Hook 可能导致应用崩溃或系统功能异常。仅在推荐 Hook 无效时使用。";
"HOOK_LLC" = "底层文件处理";
"HOOK_LLC_DESC" = "在底层文件打开和目录 API 中隐藏越狱路径。";
"HOOK_MEM" = "隐藏可执行内存";
"HOOK_MEM_DESC" = "过滤虚拟内存查询，避免暴露注入的可执行内存区域。";
"MEMORY_LEVEL_HIDING" = "内存级隐藏";
"MEMORY_LEVEL_HIDING_DESC" = "从 dyld 的内存映像列表中移除注入的动态库。如果应用不稳定，请关闭此选项。";
"HOOK_DYLD_EXTRA" = "提前安装动态库";
"HOOK_DYLD_EXTRA_DESC" = "在应用启动时启用额外的动态库防护，而不是等待检测到越狱检查。";
"PSEUDO_SANDBOX" = "伪沙盒（审计）";
"PSEUDO_SANDBOX_DESC" = "恢复应用的原生沙盒视图（容器 + 系统目录 + 共享区域）。审计模式仅记录差异而不隐藏——在共享区域验证前保持关闭。在测试应用上启用一周，然后检查检测器日志。";
"PSEUDO_SANDBOX_OFF" = "关闭";
"PSEUDO_SANDBOX_AUDIT" = "审计";
"PSEUDO_SANDBOX_STRICT" = "严格";
"PSEUDO_SANDBOX_STRICT_DESC" = "在允许列表之外强制失败关闭。需要先启用审计——仅在共享区域验证后启用。";
"PATH_REWRITE" = "重写越狱路径";
"PATH_REWRITE_DESC" = "在系统调用和 libc 层面重写调用方缓冲区中的越狱路径，使文件操作自然以 ENOENT 失败。重写后的字符串对应用自身的日志和界面可见。";
"DETECTOR_PATCHES" = "定向检测器覆盖";
"DETECTOR_PATCHES_DESC" = "通过直接覆盖方法或 Shadow 的行为 Hook，消除受支持检测库的越狱探测。Objective-C 适配器需要启用“设备检查”。默认关闭；仅为使用对应库的应用开启。freeRASP 选项会阻止 SDK 启动，因此会抑制所有 freeRASP 回调。";
