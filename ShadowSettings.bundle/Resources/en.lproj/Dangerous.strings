"DNGR_HOOKS" = "⚠︎ Dangerous Hooks";
"DNGR_HOOKS_DESC" = "Low-level bypass methods. May crash apps or break system features. Enable only if the Recommended hooks did not work.";
"HOOK_SANDBOX" = "Enforce App Sandbox";
"HOOK_SANDBOX_DESC" = "Makes privileged operations and jailbreak-only services fail as they would inside a stock app sandbox.\n\nThese low-level hooks may crash apps or break system features. Use them only when recommended hooks do not work.";
"HOOK_LLC" = "Low-Level File Handles";
"HOOK_LLC_DESC" = "Hides jailbreak paths from low-level file-opening and directory APIs.";
"HOOK_MEM" = "Hide Executable Memory";
"HOOK_MEM_DESC" = "Filters virtual-memory queries so injected executable regions are not exposed.";
"MEMORY_LEVEL_HIDING" = "Memory-Level Hiding";
"MEMORY_LEVEL_HIDING_DESC" = "Removes injected libraries from dyld's in-memory image list. Turn this off if an app becomes unstable.";
"HOOK_DYLD_EXTRA" = "Install Dynamic Libraries Early";
"HOOK_DYLD_EXTRA_DESC" = "Starts the extra dynamic-library protections at launch instead of waiting until jailbreak detection is observed.";
"PSEUDO_SANDBOX" = "Pseudo Sandbox (Audit)";
"PSEUDO_SANDBOX_DESC" = "Restores the app's stock sandbox view (container + stock system + shared carve-outs). Audit mode logs divergences without hiding — enforce stays off until carve-outs are proven. Enable for 1 week on test apps, then check Detector Log.";
"PSEUDO_SANDBOX_OFF" = "Off";
"PSEUDO_SANDBOX_AUDIT" = "Audit";
"PSEUDO_SANDBOX_STRICT" = "Strict";
"PSEUDO_SANDBOX_STRICT_DESC" = "Enforce fail-closed outside the allowlist. Requires audit toggle — only enable after carve-outs are validated.";
"PATH_REWRITE" = "Rewrite Jailbreak Paths";
"PATH_REWRITE_DESC" = "Rewrites jailbreak paths in the caller's buffer at the syscall and libc level, so file operations naturally fail with ENOENT. The rewritten string is visible to the app's own logging and UI.";
"DETECTOR_PATCHES" = "Targeted Detector Overrides";
"DETECTOR_PATCHES_DESC" = "Neutralizes supported detector-library jailbreak probes through direct method overrides or Shadow's behavioral hooks. Objective-C adapters require Device Check. Disabled by default; enable only for apps using the matching library. The freeRASP option disables SDK startup, so it suppresses every freeRASP callback.";
