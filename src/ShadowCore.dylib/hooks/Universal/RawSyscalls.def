// Raw-syscall intercept registry — the SINGLE source of truth for the
// syscall(2)/__syscall(2) interception surface (hooks/syscall.x). Every
// intercepted number, its policy category, rewrite/fd-return flags and its
// forwarding shape live here; syscall.x includes this file with
// SHADW_RAWSYSCALL redefined per use site to generate, from one list:
//
//   - the passthrough OR-chains of replaced_syscall / replaced___syscall
//     (the trampoline test must stay a chain of compares on `number` — it
//     lowers to cmp/branch only and clobbers nothing);
//   - the forwarding switch (shdw_fwd_<FWD> bodies, one per shape);
//   - the policy category switch the dispatch switches on.
//
// Fields:
//   NUM     - SYS_* constant name (the intercepted syscall number)
//   CAT     - policy category, SHADW_RAW_CAT_<CAT> in syscall.x's dispatch
//   FWD     - forwarding body, shdw_fwd_<FWD>(int, va_list) in syscall.x
//   REWRITE - natural-ENOENT rewrite lane in svc_patch.x:
//             0 never, 1 always, 2 only when the open-family call has no
//             O_CREAT (a rewrite must not create the munged spelling).
//   FD      - returns an open fd on success; the raw dispatch verifies the
//             returned descriptor before handing it to an external caller.
//
// tests/verify-syscall-meta.sh asserts every entry's forwarder and category
// exist in syscall.x; the build itself fails on a typo'd FWD (undefined
// symbol) or CAT (unknown enumerator).

#ifndef SHADW_RAWSYSCALL
#error "RawSyscalls.def must be included with SHADW_RAWSYSCALL defined"
#endif

SHADW_RAWSYSCALL(SYS_ptrace, PTRACE, PTRACE, 0, 0)
SHADW_RAWSYSCALL(SYS_open, PATH, OPEN, 2, 1)
SHADW_RAWSYSCALL(SYS_chdir, PATH, P1, 0, 0)
SHADW_RAWSYSCALL(SYS_access, PATH, P2I, 1, 0)
SHADW_RAWSYSCALL(SYS_execve, PATH, EXECVE, 1, 0)
SHADW_RAWSYSCALL(SYS_chroot, PATH, P1, 0, 0)
SHADW_RAWSYSCALL(SYS_rmdir, PATH, P1, 0, 0)
SHADW_RAWSYSCALL(SYS_mkdir, PATH, P2I, 0, 0)
SHADW_RAWSYSCALL(SYS_chmod, PATH, P2I, 0, 0)
SHADW_RAWSYSCALL(SYS_chown, PATH3I, PATH3I, 0, 0)
SHADW_RAWSYSCALL(SYS_lchown, PATH3I, PATH3I, 0, 0)
SHADW_RAWSYSCALL(SYS_mknod, PATHMD, PATHMD, 0, 0)
SHADW_RAWSYSCALL(SYS_mkfifo, PATH, P2I, 0, 0)
SHADW_RAWSYSCALL(SYS_truncate, PATHOFF, PATHOFF, 0, 0)
SHADW_RAWSYSCALL(SYS_ftruncate, FDOFF, FDOFF, 0, 0)
SHADW_RAWSYSCALL(SYS_chflags, PATH, P2I, 0, 0)
SHADW_RAWSYSCALL(SYS_fchmod, FDMODE, FDMODE, 0, 0)
SHADW_RAWSYSCALL(SYS_fchown, FDUIDGID, FDUIDGID, 0, 0)
SHADW_RAWSYSCALL(SYS_chmod_extended, PATH, XATTR4, 0, 0)
SHADW_RAWSYSCALL(SYS_copyfile, COPYFILE, PATHPATH, 0, 0)
SHADW_RAWSYSCALL(SYS_clonefileat, CLONEAT, CLONEAT, 0, 0)
SHADW_RAWSYSCALL(SYS_fclonefileat, FDPATH, FDPATH, 0, 0)
SHADW_RAWSYSCALL(SYS_stat, PATH, P2I, 1, 0)
SHADW_RAWSYSCALL(SYS_lstat, PATH, P2I, 1, 0)
SHADW_RAWSYSCALL(SYS_getattrlist, PATH, GETATTRLIST, 1, 0)
SHADW_RAWSYSCALL(SYS_getxattr, PATH, GETXATTR, 1, 0)
SHADW_RAWSYSCALL(SYS_fgetxattr, FDXATTR, FGETXATTR, 0, 0)
SHADW_RAWSYSCALL(SYS_listxattr, PATH, LISTXATTR, 1, 0)
SHADW_RAWSYSCALL(SYS_flistxattr, FDXATTR, FLISTXATTR, 0, 0)
SHADW_RAWSYSCALL(SYS_open_extended, PATH, OPENEXT, 2, 1)
SHADW_RAWSYSCALL(SYS_stat_extended, PATH, XATTR4, 1, 0)
SHADW_RAWSYSCALL(SYS_lstat_extended, PATH, XATTR4, 1, 0)
// SYS_access_extended's first argument is a binary entries buffer, NOT a
// path string: the dispatch deliberately never inspects it (CAT_NONE); it
// is still forwarded with its exact arity.
SHADW_RAWSYSCALL(SYS_access_extended, NONE, ACCESSEXT, 0, 0)
SHADW_RAWSYSCALL(SYS_stat64, PATH, P2I, 1, 0)
SHADW_RAWSYSCALL(SYS_lstat64, PATH, P2I, 1, 0)
SHADW_RAWSYSCALL(SYS_stat64_extended, PATH, XATTR4, 1, 0)
SHADW_RAWSYSCALL(SYS_lstat64_extended, PATH, XATTR4, 1, 0)
SHADW_RAWSYSCALL(SYS_readlink, PATH, READLINK, 1, 0)
// SYS_freadlink predates the libc wrapper (number on the 15.6 floor,
// declaration iOS 16+): same fd-based policy as the fstat family — resolve
// via F_GETPATH, fail open when the fd has no nameable path. Probe-gated:
// raw-SVC callers bypass the libc hook entirely.
#ifdef SYS_freadlink
SHADW_RAWSYSCALL(SYS_freadlink, FREADLINK, READLINK, 0, 0)
#endif
SHADW_RAWSYSCALL(SYS_pathconf, PATH, P2I, 1, 0)
SHADW_RAWSYSCALL(SYS_openat, AT, OPENAT, 2, 1)
SHADW_RAWSYSCALL(SYS_fstatat, AT, FSTATAT, 1, 0)
SHADW_RAWSYSCALL(SYS_fstatat64, AT, FSTATAT, 1, 0)
#ifdef SYS_mkfifoat
SHADW_RAWSYSCALL(SYS_mkfifoat, AT, ATMODE, 0, 0)
#endif
#ifdef SYS_mknodat
SHADW_RAWSYSCALL(SYS_mknodat, AT, ATMODEDEV, 0, 0)
#endif
SHADW_RAWSYSCALL(SYS_kill, KILL, KILL, 0, 0)
SHADW_RAWSYSCALL(SYS_kevent, KEVENT, KEVENT, 0, 0)
// kevent64 is kevent's 64-bit twin (SYS_kevent64=369, all lane SDKs incl.
// 13.7): same (kq, changelist, nchanges, ...) head, then eventlist, nevents,
// flags, timeout — 7 slots. The changelist element is struct kevent64_s
// (48 bytes, SDK sys/event.h: ident u64 @0, filter s16 @8), NOT struct
// kevent — the KEVENT64 policy scans it with its own type. EVFILT_PROC-only
// ESRCH, external-gated, same as KEVENT.
SHADW_RAWSYSCALL(SYS_kevent64, KEVENT64, KEVENT64, 0, 0)
SHADW_RAWSYSCALL(SYS_csops, CSOPS, CSOPS, 0, 0)
SHADW_RAWSYSCALL(SYS_sysctl, SYSCTL, SYSCTL, 0, 0)
SHADW_RAWSYSCALL(SYS_getdirentries64, DIRENT, GETDIRENTRIES, 0, 0)
// getfsstat(buf, bufsize, flags): the raw mount-array syscalls the libc
// getfsstat/getmntinfo wrappers filter. Without these entries the raw call is
// passthrough and leaks the mounts the wrappers remove. After-success
// category compacts the returned struct statfs array via the SAME shared
// mount filter the wrappers use (shdw_filter_mounts).
SHADW_RAWSYSCALL(SYS_getfsstat, GETFSSTAT, GETFSSTAT, 0, 0)
SHADW_RAWSYSCALL(SYS_getfsstat64, GETFSSTAT, GETFSSTAT, 0, 0)
// getattrlistbulk(dirfd, attrList, attrBuf, attrBufSize, flags): the raw
// directory-enumeration syscall the libc getattrlistbulk wrapper filters.
// Without this entry a direct syscall(SYS_getattrlistbulk, ...) bypasses the
// record filter entirely. After-success category compacts the returned
// records via the SAME shared filter the wrapper uses
// (shdw_getattrlistbulk_filter). Unconditional: the number exists on every
// lane SDK.
SHADW_RAWSYSCALL(SYS_getattrlistbulk, GETATTRLISTBULK, GETATTRLISTBULK, 0, 0)
// proc_info(callnum, pid, flavor, arg, buffer, buffersize): the __proc_info(2)
// multiplexer libproc's proc_pidinfo/proc_regionfilename route through. Without
// this entry a raw syscall(SYS_proc_info, ...) reopens the region-path leak the
// libc proc_pidinfo hook closes. The region-path flavors (PROC_PIDREGIONPATH*)
// embed the backing vnode path; the after-success category reshapes a hidden
// image's region into an anonymous one via the SAME predicate the libc hook uses.
SHADW_RAWSYSCALL(SYS_proc_info, PROCINFO, PROCINFO, 0, 0)
// Mutator/xattr errno parity: a raw syscall(2) must not
// see an object the libc wrappers report absent. Single-path mutators share
// CAT PATH (ruleset + external-hidden); fd variants share CAT FDXATTR;
// link shares CAT PATHPATH (both ends). setxattr reuses the GETXATTR shape,
// fsetxattr reuses FGETXATTR; removexattr/utimes/link need their own shapes.
SHADW_RAWSYSCALL(SYS_utimes, PATH, UTIMES, 0, 0)
SHADW_RAWSYSCALL(SYS_futimes, FDXATTR, FUTIMES, 0, 0)
SHADW_RAWSYSCALL(SYS_link, PATHPATH, LINK, 0, 0)
// exchangedata(path1, path2, options): unhooked pair-shaped existence
// oracle — the kernel reaches EXDEV only when both operands exist. Same
// both-endpoint PATHPATH policy as link (hidden+ruleset either end, ENOENT),
// with its own 3-slot forwarder. Unconditional: ancient number, all lanes.
SHADW_RAWSYSCALL(SYS_exchangedata, PATHPATH, EXCHANGEDATA, 0, 0)
// rename(from, to): the pair-shaped mutator behind rename(2). Same
// both-endpoint verdict as the libc rename hooks (entry identity plus
// ruleset either end, ENOENT), with its own 2-slot forwarder, so a raw
// SYS_rename agrees with rename(2) on every operand. Unconditional:
// ancient number, all lanes.
SHADW_RAWSYSCALL(SYS_rename, RENAME, RENAME, 0, 0)
SHADW_RAWSYSCALL(SYS_setxattr, PATH, GETXATTR, 0, 0)
SHADW_RAWSYSCALL(SYS_fsetxattr, FDXATTR, FGETXATTR, 0, 0)
SHADW_RAWSYSCALL(SYS_removexattr, PATH, REMOVEXATTR, 0, 0)
SHADW_RAWSYSCALL(SYS_fremovexattr, FDXATTR, FREMOVEXATTR, 0, 0)
// linkat family (Round 11): same hidden+ruleset pair as the libc *at hooks,
// external-gated, ENOENT on denial. linkat reuses CLONEAT (fd,path,fd,path,+flag
// — the clonefileat two-pair shape); renameat carries the RENAMEAT pair
// policy (same entry-identity verdict as the libc renameat hooks) with a
// 4-arg forwarder; unlinkat/mkdirat are single-path AT via the unconditional
// ATMODE shape; symlinkat checks the link LOCATION only (a symlink target need
// not exist, so hidden-vs-absent targets have no natural split). All numbers
// exist since iOS 8 — unconditional on every lane SDK.
SHADW_RAWSYSCALL(SYS_linkat, CLONEAT, CLONEAT, 0, 0)
SHADW_RAWSYSCALL(SYS_unlinkat, AT, ATMODE, 0, 0)
SHADW_RAWSYSCALL(SYS_mkdirat, AT, ATMODE, 0, 0)
SHADW_RAWSYSCALL(SYS_renameat, RENAMEAT, RENAMEAT, 0, 0)
SHADW_RAWSYSCALL(SYS_symlinkat, SYMLINKAT, SYMLINKAT, 0, 0)
// renameatx_np (Round 23): the *at sibling of renamex_np — same RENAMEAT
// two-pair dirfd verdict as renameat, 5-arg shape like clonefileat.
// Unconditional: the number exists on every lane SDK.
SHADW_RAWSYSCALL(SYS_renameatx_np, RENAMEAT, CLONEAT, 0, 0)
// Round 13 audit: hidden-vs-absent pairs via syscall(2) that were passthrough.
// All external-gated, hidden+ruleset, ENOENT on denial. Unconditional: numbers
// exist in the 14.5 SDK.
SHADW_RAWSYSCALL(SYS_revoke, PATH, P1, 0, 0)
SHADW_RAWSYSCALL(SYS_faccessat, AT, FSTATAT, 0, 0)
SHADW_RAWSYSCALL(SYS_fchmodat, AT, FSTATAT, 0, 0)
SHADW_RAWSYSCALL(SYS_fchownat, AT, CLONEAT, 0, 0)
SHADW_RAWSYSCALL(SYS_readlinkat, AT, FSTATAT, 0, 0)
SHADW_RAWSYSCALL(SYS_getattrlistat, AT, GETATTRLISTAT, 0, 0)
SHADW_RAWSYSCALL(SYS_setattrlist, PATH, GETATTRLIST, 0, 0)
SHADW_RAWSYSCALL(SYS_setattrlistat, AT, GETATTRLISTAT, 0, 0)
SHADW_RAWSYSCALL(SYS_open_nocancel, PATH, OPEN, 0, 1)
SHADW_RAWSYSCALL(SYS_openat_nocancel, AT, OPENAT, 0, 1)
SHADW_RAWSYSCALL(SYS_open_dprotected_np, PATH, OPENDP, 0, 1)
SHADW_RAWSYSCALL(SYS___pthread_chdir, PATH, P1, 0, 0)
SHADW_RAWSYSCALL(SYS_statfs, PATH, P2I, 0, 0)
SHADW_RAWSYSCALL(SYS_statfs64, STATFS, P2I, 0, 0)
// fstatfs64(fd, buf): the fd sibling of statfs64. The queried object is
// named by the descriptor, so policy inspects the returned mount record.
// Without this entry a direct syscall(SYS_fstatfs64, ...) bypasses the libc
// fstatfs/fstatvfs filter entirely and leaks the bindfs record. Give it a
// 2-slot fd+pointer forwarder (no existing shape reads fd-then-buffer) and an
// FSTATFS category that joins the shared filter/reshape block after success.
// Guarded: the number is SDK-declared (346 on the target SDK) but absent on
// lanes that predate fstatfs64; SYS_fstatfs (158) is NOT this — it is the
// legacy struct-statfs ABI and stays untouched.
#ifdef SYS_fstatfs64
SHADW_RAWSYSCALL(SYS_fstatfs64, FSTATFS, FSTATFS, 0, 0)
#endif
SHADW_RAWSYSCALL(SYS_mount, PATHPATH, MOUNT, 0, 0)
SHADW_RAWSYSCALL(SYS_unmount, PATH, P2I, 0, 0)
