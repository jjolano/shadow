// Raw-syscall intercept registry — the SINGLE source of truth for the
// syscall(2)/__syscall(2) interception surface (hooks/syscall.x). Every
// intercepted number, its argument count, its policy category and its
// forwarding shape live here; syscall.x includes this file with
// SHADW_RAWSYSCALL redefined per use site to generate, from one list:
//
//   - the passthrough OR-chains of replaced_syscall / replaced___syscall
//     (the trampoline test must stay a chain of compares on `number` — it
//     lowers to cmp/branch only and clobbers nothing);
//   - the forwarding switch (shdw_fwd_<FWD> bodies, one per shape);
//   - the policy category switch the dispatch switches on.
//
// Fields:
//   NUM    - SYS_* constant name (the intercepted syscall number)
//   ARITY  - maximum argument slots the forwarder reads (the open-family
//            entries read one fewer when O_CREAT is absent)
//   CAT    - policy category, SHADW_RAW_CAT_<CAT> in syscall.x's dispatch
//   FWD    - forwarding body, shdw_fwd_<FWD>(int, va_list) in syscall.x
//
// tests/verify-syscall-meta.sh asserts every entry's forwarder and category
// exist in syscall.x; the build itself fails on a typo'd FWD (undefined
// symbol) or CAT (unknown enumerator).

#ifndef SHADW_RAWSYSCALL
#error "RawSyscalls.def must be included with SHADW_RAWSYSCALL defined"
#endif

SHADW_RAWSYSCALL(SYS_ptrace,           4, PTRACE,     PTRACE)
SHADW_RAWSYSCALL(SYS_open,             3, PATH,       OPEN)
SHADW_RAWSYSCALL(SYS_chdir,            1, PATH,       P1)
SHADW_RAWSYSCALL(SYS_access,           2, PATH,       P2I)
SHADW_RAWSYSCALL(SYS_execve,           3, PATH,       EXECVE)
SHADW_RAWSYSCALL(SYS_chroot,           1, PATH,       P1)
SHADW_RAWSYSCALL(SYS_rmdir,            1, PATH,       P1)
SHADW_RAWSYSCALL(SYS_mkdir,            2, PATH,       P2I)
SHADW_RAWSYSCALL(SYS_chmod,            2, PATH,       P2I)
SHADW_RAWSYSCALL(SYS_chown,            3, PATH3I,     PATH3I)
SHADW_RAWSYSCALL(SYS_lchown,           3, PATH3I,     PATH3I)
SHADW_RAWSYSCALL(SYS_mknod,            3, PATHMD,     PATHMD)
SHADW_RAWSYSCALL(SYS_mkfifo,           2, PATH,       P2I)
SHADW_RAWSYSCALL(SYS_truncate,         2, PATHOFF,    PATHOFF)
SHADW_RAWSYSCALL(SYS_ftruncate,        2, FDOFF,      FDOFF)
SHADW_RAWSYSCALL(SYS_chflags,          2, PATH,       P2I)
SHADW_RAWSYSCALL(SYS_fchmod,           2, FDMODE,     FDMODE)
SHADW_RAWSYSCALL(SYS_fchown,           3, FDUIDGID,   FDUIDGID)
SHADW_RAWSYSCALL(SYS_chmod_extended,   4, PATH,       XATTR4)
SHADW_RAWSYSCALL(SYS_copyfile,         4, PATHPATH,    PATHPATH)
SHADW_RAWSYSCALL(SYS_clonefileat,      5, CLONEAT,     CLONEAT)
SHADW_RAWSYSCALL(SYS_fclonefileat,     4, FDPATH,      FDPATH)
SHADW_RAWSYSCALL(SYS_stat,             2, PATH,       P2I)
SHADW_RAWSYSCALL(SYS_lstat,            2, PATH,       P2I)
SHADW_RAWSYSCALL(SYS_getattrlist,      5, PATH,       GETATTRLIST)
SHADW_RAWSYSCALL(SYS_getxattr,         6, PATH,       GETXATTR)
SHADW_RAWSYSCALL(SYS_fgetxattr,        6, FDXATTR,    FGETXATTR)
SHADW_RAWSYSCALL(SYS_listxattr,        4, PATH,       LISTXATTR)
SHADW_RAWSYSCALL(SYS_flistxattr,       4, FDXATTR,    FLISTXATTR)
SHADW_RAWSYSCALL(SYS_open_extended,    6, PATH,       OPENEXT)
SHADW_RAWSYSCALL(SYS_stat_extended,    4, PATH,       XATTR4)
SHADW_RAWSYSCALL(SYS_lstat_extended,   4, PATH,       XATTR4)
// SYS_access_extended's first argument is a binary entries buffer, NOT a
// path string: the dispatch deliberately never inspects it (CAT_NONE); it
// is still forwarded with its exact arity.
SHADW_RAWSYSCALL(SYS_access_extended,  4, NONE,       ACCESSEXT)
SHADW_RAWSYSCALL(SYS_stat64,           2, PATH,       P2I)
SHADW_RAWSYSCALL(SYS_lstat64,          2, PATH,       P2I)
SHADW_RAWSYSCALL(SYS_stat64_extended,  4, PATH,       XATTR4)
SHADW_RAWSYSCALL(SYS_lstat64_extended, 4, PATH,       XATTR4)
SHADW_RAWSYSCALL(SYS_readlink,         3, PATH,       READLINK)
// SYS_freadlink predates the libc wrapper (number on the 15.6 floor,
// declaration iOS 16+): same fd-based policy as the fstat family — resolve
// via F_GETPATH, fail open when the fd has no nameable path. Probe-gated
// (SDK-RESEARCH.md): raw-SVC callers bypass the libc hook entirely.
#ifdef SYS_freadlink
SHADW_RAWSYSCALL(SYS_freadlink,        3, FREADLINK,  READLINK)
#endif
SHADW_RAWSYSCALL(SYS_pathconf,         2, PATH,       P2I)
SHADW_RAWSYSCALL(SYS_openat,           4, AT,         OPENAT)
SHADW_RAWSYSCALL(SYS_fstatat,          4, AT,         FSTATAT)
SHADW_RAWSYSCALL(SYS_fstatat64,        4, AT,         FSTATAT)
#ifdef SYS_mkfifoat
SHADW_RAWSYSCALL(SYS_mkfifoat,         3, AT,         ATMODE)
#endif
#ifdef SYS_mknodat
SHADW_RAWSYSCALL(SYS_mknodat,          4, AT,         ATMODEDEV)
#endif
SHADW_RAWSYSCALL(SYS_kill,             2, KILL,       KILL)
SHADW_RAWSYSCALL(SYS_kevent,           6, KEVENT,     KEVENT)
// kevent64 is kevent's 64-bit twin (SYS_kevent64=369, all lane SDKs incl.
// 13.7): same (kq, changelist, nchanges, ...) head, then eventlist, nevents,
// flags, timeout — 7 slots. The changelist element is struct kevent64_s
// (48 bytes, SDK sys/event.h: ident u64 @0, filter s16 @8), NOT struct
// kevent — the KEVENT64 policy scans it with its own type. EVFILT_PROC-only
// ESRCH, external-gated, same as KEVENT.
SHADW_RAWSYSCALL(SYS_kevent64,         7, KEVENT64,   KEVENT64)
SHADW_RAWSYSCALL(SYS_csops,            4, CSOPS,      CSOPS)
SHADW_RAWSYSCALL(SYS_sysctl,           6, SYSCTL,     SYSCTL)
SHADW_RAWSYSCALL(SYS_getdirentries64,  4, DIRENT,     GETDIRENTRIES)
// getfsstat(buf, bufsize, flags): the raw mount-array syscalls the libc
// getfsstat/getmntinfo wrappers filter. Without these entries the raw call is
// passthrough and leaks the mounts the wrappers remove. After-success
// category compacts the returned struct statfs array via the SAME shared
// mount filter the wrappers use (shdw_filter_mounts).
SHADW_RAWSYSCALL(SYS_getfsstat,        3, GETFSSTAT,  GETFSSTAT)
SHADW_RAWSYSCALL(SYS_getfsstat64,      3, GETFSSTAT,  GETFSSTAT)
// proc_info(callnum, pid, flavor, arg, buffer, buffersize): the __proc_info(2)
// multiplexer libproc's proc_pidinfo/proc_regionfilename route through. Without
// this entry a raw syscall(SYS_proc_info, ...) reopens the region-path leak the
// libc proc_pidinfo hook closes. The region-path flavors (PROC_PIDREGIONPATH*)
// embed the backing vnode path; the after-success category reshapes a hidden
// image's region into an anonymous one via the SAME predicate the libc hook uses.
SHADW_RAWSYSCALL(SYS_proc_info,        6, PROCINFO,   PROCINFO)
// Mutator/xattr errno parity (Effulgence mutxattr): a raw syscall(2) must not
// see an object the libc wrappers report absent. Single-path mutators share
// CAT PATH (ruleset + external-hidden); fd variants share CAT FDXATTR;
// link shares CAT PATHPATH (both ends). setxattr reuses the GETXATTR shape,
// fsetxattr reuses FGETXATTR; removexattr/utimes/link need their own shapes.
SHADW_RAWSYSCALL(SYS_utimes,           2, PATH,       UTIMES)
SHADW_RAWSYSCALL(SYS_futimes,          2, FDXATTR,    FUTIMES)
SHADW_RAWSYSCALL(SYS_link,             2, PATHPATH,   LINK)
SHADW_RAWSYSCALL(SYS_setxattr,         6, PATH,       GETXATTR)
SHADW_RAWSYSCALL(SYS_fsetxattr,        6, FDXATTR,    FGETXATTR)
SHADW_RAWSYSCALL(SYS_removexattr,      3, PATH,       REMOVEXATTR)
SHADW_RAWSYSCALL(SYS_fremovexattr,     3, FDXATTR,    FREMOVEXATTR)
// linkat family (Round 11): same hidden+ruleset pair as the libc *at hooks,
// external-gated, ENOENT on denial. linkat reuses CLONEAT (fd,path,fd,path,+flag
// — the clonefileat two-pair shape); renameat reuses the CLONEAT policy with a
// 4-arg forwarder; unlinkat/mkdirat are single-path AT via the unconditional
// ATMODE shape; symlinkat checks the link LOCATION only (a symlink target need
// not exist, so hidden-vs-absent targets have no natural split). All numbers
// exist since iOS 8 — unconditional on every lane SDK.
SHADW_RAWSYSCALL(SYS_linkat,           5, CLONEAT,    CLONEAT)
SHADW_RAWSYSCALL(SYS_unlinkat,         3, AT,         ATMODE)
SHADW_RAWSYSCALL(SYS_mkdirat,          3, AT,         ATMODE)
SHADW_RAWSYSCALL(SYS_renameat,         4, CLONEAT,    RENAMEAT)
SHADW_RAWSYSCALL(SYS_symlinkat,        3, SYMLINKAT,  SYMLINKAT)
// Round 13 audit: hidden-vs-absent pairs via syscall(2) that were passthrough.
// All external-gated, hidden+ruleset, ENOENT on denial. Unconditional: numbers
// exist in the 14.5 SDK.
SHADW_RAWSYSCALL(SYS_revoke,           1, PATH,       P1)
SHADW_RAWSYSCALL(SYS_faccessat,        4, AT,         FSTATAT)
SHADW_RAWSYSCALL(SYS_fchmodat,         4, AT,         FSTATAT)
SHADW_RAWSYSCALL(SYS_fchownat,         5, AT,         CLONEAT)
SHADW_RAWSYSCALL(SYS_readlinkat,       4, AT,         FSTATAT)
SHADW_RAWSYSCALL(SYS_getattrlistat,    6, AT,         GETATTRLISTAT)
SHADW_RAWSYSCALL(SYS_setattrlist,      5, PATH,       GETATTRLIST)
SHADW_RAWSYSCALL(SYS_setattrlistat,    6, AT,         GETATTRLISTAT)
SHADW_RAWSYSCALL(SYS_open_nocancel,    3, PATH,       OPEN)
SHADW_RAWSYSCALL(SYS_openat_nocancel,  4, AT,         OPENAT)
SHADW_RAWSYSCALL(SYS_open_dprotected_np, 5, PATH,     OPENDP)
SHADW_RAWSYSCALL(SYS___pthread_chdir,  1, PATH,       P1)
SHADW_RAWSYSCALL(SYS_statfs,           2, PATH,       P2I)
SHADW_RAWSYSCALL(SYS_statfs64,         2, STATFS,     P2I)
SHADW_RAWSYSCALL(SYS_mount,            4, PATHPATH,   RENAMEAT)
SHADW_RAWSYSCALL(SYS_unmount,          2, PATH,       P2I)
